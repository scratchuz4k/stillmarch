{
  "name": "stillmarch-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "test": "vitest run",
    "type-check": "tsc -p shared && tsc -p server && npm run type-check -w client",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
